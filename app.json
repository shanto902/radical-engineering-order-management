{
  "expo": {
    "name": "Radical Orders",
    "slug": "radical-engineering-order-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "native",
          "backgroundColor": "#3c1100"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3c1100"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.radicalengineering.orders"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3c1100"
      },
      "package": "com.radicalengineering.orders",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "permissions": ["INTERNET", "VIBRATE", "RECEIVE_BOOT_COMPLETED"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "radicalorders",
    "extra": {
      "eas": {
        "projectId": "8d4c18c5-5582-409e-911d-a06308c0fb1a"
      }
    },
    "owner": "ashik-shanto"
  }
}
